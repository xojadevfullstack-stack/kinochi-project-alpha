# Kinochi Backend — environment variables EXAMPLE
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — only .env.example!

# ── General ──────────────────────────────────────────────────────
PROJECT_NAME=Kinochi
VERSION=0.1.0
APP_ENV=development
# ENVIRONMENT=development
# ENABLE_DEV_LOGIN: only effective when APP_ENV/ENVIRONMENT is not production
ENABLE_DEV_LOGIN=false
DEBUG=false

# ── Database (async PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kinochi:your_db_password@localhost:5432/kinochi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_USER=kinochi
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=kinochi

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────
# Explicit allowed origins (default includes https://kinochi-project-alpha.vercel.app and https://kinochi.uz)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Alias for CORS_ORIGINS (comma-separated or JSON list)
CORS_ALLOWED_ORIGINS=https://kinochi-project-alpha.vercel.app,https://kinochi.uz
# Optional preview regex (strictly optional, disabled by default; use team slug if needed):
# CORS_ORIGIN_REGEX=^https://kinochi-project-alpha-[a-z0-9-]+-<team-slug>\.vercel\.app$

# ── Reverse Proxy / Rate Limiting ────────────────────────────────
TRUST_PROXY=false
TRUSTED_PROXIES_COUNT=1

# ── Security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_64_char_hex_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Telegram ─────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
STORAGE_CHANNEL_ID=your_storage_channel_id_here
BOT_API_SECRET=your_bot_api_secret_here

# ── Parser & Telethon Userbot ─────────────────────────────────────
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_STRING_SESSION=your_telethon_string_session_here
AUTO_TOPIC_CHAT_ID=your_forum_channel_id
TMDB_API_KEY=your_tmdb_api_key_or_read_token
SCRAPER_ENABLED=false
UZMOVI_BOT_CODE_VERIFIED=false


